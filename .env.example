# ════════════════════════════════════════════════════════════
# ШАБЛОН .env — скопируйте в файл .env и заполните своими значениями:
#   cp .env.example .env
#
# Переменные из .env (и окружения) имеют ПРИОРИТЕТ над config.py.
# Тарифы (TARIFFS) и база знаний (FAQ_BASE) правятся только в config.py —
# они структурированные и в .env не выносятся.
#
# .env НЕ коммитится в git (уже в .gitignore) — там секреты!
# ════════════════════════════════════════════════════════════

# ── БОТ (обязательные) ─────────────────────────────────────
BOT_TOKEN=СЮДА_ТОКЕН        # токен от @BotFather: 123456789:AAE...
# Корневые сотрудники: создаются в базе при старте, удалить из панели нельзя.
# Роль определяется самой переменной:
#   OWNER_ID — 👑 владелец (управление админами, удаление данных, жалобы 1–3⭐);
#   ADMIN_ID — 👮 администратор (если OWNER_ID не заполнен — становится владельцем).
# Остальных сотрудников владелец назначает кнопками:
# ⚙️ Настройки → 👮 Админы → ➕ Добавить администратора.
ADMIN_ID=123456789          # числовой Telegram ID админа (узнать: @userinfobot)
OWNER_ID=123456789          # числовой Telegram ID владельца

# ── GigaChat (только этот AI-провайдер) ────────────────────
# Ключ авторизации копируется из Сбер Studio как есть,
# ничего кодировать в Base64 вручную не нужно.
USE_AI=True                 # False — бот работает только на кнопках
AI_API_KEY=                 # пусто = AI выключится автоматически, без ошибок
AI_SCOPE=GIGACHAT_API_PERS  # GIGACHAT_API_PERS — физлицам (бесплатный freemium)
AI_MODEL=GigaChat-2         # одна дешёвая модель (Lite) — и парсинг, и FAQ
AI_VERIFY_SSL=False         # False — SDK сам подставит сертификаты Минцифры
AI_TIMEOUT=30               # таймаут запроса к GigaChat, секунд

# ── ДЕМО-РЕЖИМ ─────────────────────────────────────────────
DEMO_MODE=True              # пометка «🧪 ДЕМО-РЕЖИМ» в ответах клиентам
SEED_DEMO_DATA=True         # предзаполнить базу демо-клиентами/бронями/отзывами

# ── ДАННЫЕ КЛУБА (демо, вымышленные) ───────────────────────
# ПРАВИЛО: пустая ссылка = кнопка в боте НЕ создаётся.
CLUB_NAME=КИБЕР-ДЕМО
CLUB_ADDRESS=ул. Примерная, 1, ТЦ «Тест», 2 этаж
CLUB_PHONE=+7 (000) 000-00-00
CLUB_HOURS=круглосуточно
CLUB_MAPS_URL=https://2gis.ru/demo
CLUB_VK_URL=
CLUB_SITE_URL=
CLUB_PCS_TOTAL=10           # всего ПК (для оценки загрузки /week)

# ── НАПОМИНАНИЯ И ОТЗЫВЫ ───────────────────────────────────
MAX_ACTIVE_BOOKINGS=3       # сколько активных броней может держать один клиент
REMIND_BEFORE_HOURS=2       # напоминание за N часов до начала брони
REVIEW_AFTER_HOURS=1        # запрос отзыва через N часов после конца брони

# ── ПРОЧЕЕ ─────────────────────────────────────────────────
TIMEZONE=Europe/Moscow      # часовой пояс клуба
DB_PATH=club_bot.db         # файл базы SQLite (на Railway: /data/club_bot.db)
LOG_FILE=bot.log            # файл логов
